// =============================================================================
// Vault domain: media folders
// =============================================================================
// Owned by @marinoscar/vault-db. `vault-db sync` copies this file into the app's
// prisma/fragments/ (never edit the copy); `platform db compose` then composes it
// with the platform fragments into prisma/schema/.
// Media folders and the link row between a folder and a storage object.

model MediaFolder {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user  User              @relation("UserMediaFolders", fields: [userId], references: [id], onDelete: Cascade)
  files MediaFolderFile[]

  @@index([userId])
  @@map("media_folders")
}

// A file belongs to at most one media folder. The platform's StorageObject has
// no media_folder_id column (a fragment cannot add a column to a platform
// model), so the link is its own row, keyed by the object. The foreign key is
// composite (object_id, org_id), as every link to an org-owned table must be.
//
// Deleting a folder deletes only the link rows: the objects stay and fall back
// to "no folder", exactly what ON DELETE SET NULL on the old column did.

model MediaFolderFile {
  objectId      String   @id @map("object_id") @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  mediaFolderId String   @map("media_folder_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  object      StorageObject @relation(fields: [objectId, orgId], references: [id, orgId], onDelete: Cascade)
  mediaFolder MediaFolder   @relation(fields: [mediaFolderId], references: [id], onDelete: Cascade)

  @@unique([objectId, orgId])
  @@index([mediaFolderId])
  @@map("media_folder_files")
}

extend model User {
  mediaFolders MediaFolder[] @relation("UserMediaFolders")
}

extend model StorageObject {
  mediaFolderFile MediaFolderFile?
}
