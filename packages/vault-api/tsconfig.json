{
  // Typecheck and ts-jest. The package is "type": "commonjs", so NodeNext keeps relative imports
  // extensionless, like apps/api. Decorator metadata is on: the slices are Nest providers.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node", "jest"]
  },
  "include": ["src", "test"]
}
