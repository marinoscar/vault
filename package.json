{
  "name": "vault",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node -e \"const f=require('fs');const d='infra/compose/';if(!f.existsSync(d+'.env')){f.copyFileSync(d+'.env.example',d+'.env');console.log('created infra/compose/.env')}else console.log('infra/compose/.env exists')\"",
    "api": "npm -w apps/api",
    "web": "npm -w apps/web",
    "api:dev": "npm -w apps/api run start:dev",
    "web:dev": "npm -w apps/web run dev",
    "api:test": "npm -w apps/api test",
    "web:test": "npm -w apps/web test",
    "vault:migrate-ai-key": "npm -w apps/api run vault:migrate-ai-key --",
    "vault:migrate-ai-platform": "npm -w apps/api run vault:migrate-ai-platform --",
    "vault:migrate-storage-config": "npm -w apps/api run vault:migrate-storage-config --",
    "cli": "node apps/cli/dist/cli.js",
    "cli:build": "npm run build --workspace=cli",
    "vault": "node apps/cli/dist/cli.js",
    "platform:infra:sync": "platform-infra sync",
    "build:packages": "npm run build -w @marinoscar/vault-contract -w @marinoscar/vault-db && npm run prisma:generate --workspace=api && npm run build -w @marinoscar/vault-api",
    "typecheck:packages": "npm run typecheck -w @marinoscar/vault-contract -w @marinoscar/vault-db -w @marinoscar/vault-api",
    "test:packages": "npm run test:run -w @marinoscar/vault-contract -w @marinoscar/vault-db -w @marinoscar/vault-api",
    "check:package-docs": "node scripts/vault-packages/check-package-docs.mjs",
    "check:package-pack": "node scripts/vault-packages/check-package-pack.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build:packages && changeset publish"
  },
  "overrides": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@marinoscar/platform-contract": "$@marinoscar/platform-contract"
  },
  "devDependencies": {
    "@marinoscar/platform-contract": "0.1.0-next.21",
    "@marinoscar/platform-infra": "0.1.0-next.21",
    "@changesets/cli": "^2.31.1"
  }
}
