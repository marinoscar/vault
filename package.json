{
  "name": "vault",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node -e \"const f=require('fs');const d='infra/compose/';if(!f.existsSync(d+'.env')){f.copyFileSync(d+'.env.example',d+'.env');console.log('created infra/compose/.env')}else console.log('infra/compose/.env exists')\"",
    "api": "npm -w apps/api",
    "web": "npm -w apps/web",
    "api:dev": "npm -w apps/api run start:dev",
    "web:dev": "npm -w apps/web run dev",
    "api:test": "npm -w apps/api test",
    "web:test": "npm -w apps/web test",
    "app": "node tools/app/bin/app.js",
    "app:build": "npm -w tools/app run build",
    "vaultcli": "node tools/vaultcli/bin/vaultcli.js",
    "vaultcli:build": "npm -w tools/vaultcli run build"
  },
  "overrides": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@marinoscar/platform-contract": "$@marinoscar/platform-contract"
  },
  "devDependencies": {
    "@marinoscar/platform-contract": "0.1.0-next.21"
  }
}
