# -----------------------------------------------------------------------------
# App variables (Vault)
# -----------------------------------------------------------------------------
# Variables of this application only, appended to infra/compose/.env.example
# after the platform's by `platform-infra sync` (this file is APP-OWNED: it is
# created once and never overwritten; .env.example itself is generated). Add a
# variable here as KEY=value with its explanation on the lines above it, then
# run the sync. Never add a commented-out KEY=value line: the deploy wizard
# reads every such line as a declared variable.

# -----------------------------------------------------------------------------
# Vault encryption
# -----------------------------------------------------------------------------
# 32-byte key for secret values at rest (hex-encoded, 64 characters). The API
# encrypts secret versions, the AI key kept in system settings and the
# scheduled-backup password with it. Required; it must not change on a database
# that already holds secrets. Generate with: openssl rand -hex 32
# This is a DIFFERENT key from SECRETS_ENCRYPTION_KEY (platform credential
# store). Never reuse one for the other.
VAULT_ENCRYPTION_KEY=

# Card face image size cap, in bytes (default 5242880 = 5 MB). Applies only to
# card_front and card_back secret attachments. A non-numeric or non-positive
# value is ignored and the default is used instead. Since E4.1 this is only the
# default for the vaultCards.imageMaxBytes system setting; once an administrator
# saves that setting, the stored value wins.
CARD_IMAGE_MAX_BYTES=5242880

# -----------------------------------------------------------------------------
# Object storage (read by the Vault storage module today)
# -----------------------------------------------------------------------------
# Provider id. Only s3 is supported. The Vault API reads these four variables
# and the endpoint below from the environment; the platform's storage settings
# are not used by Vault until its storage module moves to the platform (E3+).
# Tracked in docs/platform-adoption/local-exceptions.md.
STORAGE_PROVIDER=s3

# Bucket name, region and AWS credentials for S3 (or an S3-compatible service).
# For AWS S3 leave the endpoint unset. For MinIO or LocalStack set S3_ENDPOINT
# (for example http://localhost:9000) in .env as well; it is optional and is
# not declared here so that the template declares no endpoint by default.
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Observability (debug only)
# -----------------------------------------------------------------------------
# Set OTEL_DEBUG to true in .env to enable OpenTelemetry diagnostic logging
# (development only). Anything other than true leaves it off.
