# Test Environment Configuration
NODE_ENV=test

# Test Database (use separate test database!)
# Individual connection parameters (preferred method)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=vault_app
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vault_test
POSTGRES_SSL=false


# JWT Configuration
JWT_SECRET=test-secret-key-minimum-32-characters-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# Google OAuth (mocked in tests)
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Admin Bootstrap
INITIAL_ADMIN_EMAIL=admin@example.com

# App URL
APP_URL=http://localhost:3000

# Platform credential store key (base64, 32 bytes). Test-only value.
SECRETS_ENCRYPTION_KEY=dmF1bHQtdGVzdC1zZWNyZXRzLWVuY3J5cHRpb24tazE=

# Vault secret values key (hex, 32 bytes). Test-only value.
VAULT_ENCRYPTION_KEY=0000000000000000000000000000000011111111111111111111111111111111

# Disable telemetry in tests
OTEL_ENABLED=false
