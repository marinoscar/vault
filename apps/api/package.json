{
  "name": "api",
  "version": "1.0.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "test": "jest --config ./test/jest.config.js --testPathIgnorePatterns='e2e' --testPathIgnorePatterns='\\.db\\.spec\\.ts$'",
    "test:all": "jest --config ./test/jest.config.js",
    "test:watch": "jest --config ./test/jest.config.js --watch --testPathIgnorePatterns='e2e' --testPathIgnorePatterns='\\.db\\.spec\\.ts$'",
    "test:cov": "jest --config ./test/jest.config.js --coverage --testPathIgnorePatterns='e2e' --testPathIgnorePatterns='\\.db\\.spec\\.ts$'",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config ./test/jest.config.js --testPathIgnorePatterns='e2e'",
    "test:e2e": "jest --config ./test/jest.config.js --testRegex '.e2e.spec.ts$'",
    "test:unit": "jest --config ./test/jest.config.js --testPathIgnorePatterns='e2e' --testPathIgnorePatterns='\\.db\\.spec\\.ts$'",
    "test:ci": "jest --config ./test/jest.config.js --coverage --ci --reporters=default --reporters=jest-junit --testPathIgnorePatterns='e2e' --testPathIgnorePatterns='\\.db\\.spec\\.ts$'",
    "prisma": "node scripts/prisma-env.js",
    "prisma:generate": "node scripts/prisma-env.js generate",
    "prisma:migrate": "node scripts/prisma-env.js migrate deploy",
    "prisma:migrate:dev": "node scripts/prisma-env.js migrate dev",
    "prisma:studio": "node scripts/prisma-env.js studio",
    "prisma:seed": "node scripts/prisma-env.js db seed",
    "prisma:push": "node scripts/prisma-env.js db push",
    "prisma:validate": "node scripts/prisma-env.js validate",
    "db:compose": "platform db compose",
    "db:compose:check": "platform db compose --check",
    "db:sync": "platform db sync",
    "db:check": "platform db check",
    "db:check:database": "node scripts/platform-env.js db check --database",
    "db:drift": "node scripts/platform-env.js db drift",
    "db:baseline": "node scripts/platform-env.js db baseline",
    "db:policies": "platform db policies",
    "db:test": "node scripts/test-db-connection.js",
    "vault:migrate-ai-key": "ts-node --project prisma/tsconfig.json --transpile-only scripts/migrate-ai-key.ts",
    "vault:migrate-ai-platform": "ts-node --project prisma/tsconfig.json --transpile-only scripts/migrate-ai-platform.ts",
    "vault:migrate-settings": "ts-node --project prisma/tsconfig.json --transpile-only scripts/migrate-settings.ts",
    "test:db": "jest --config ./test/jest.config.js --testRegex '\\.db\\.spec\\.ts$' --runInBand",
    "prisma:typecheck": "tsc -p prisma/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@app/shared": "*",
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/lib-storage": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.2",
    "@marinoscar/platform-api": "0.1.0-next.21",
    "@marinoscar/platform-contract": "0.1.0-next.21",
    "@marinoscar/platform-db": "0.1.0-next.21",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "~2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@zip.js/zip.js": "2.23.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "nestjs-zod": "^5.4.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.12",
    "@types/jest": "^29.x",
    "@types/node": "^24.x",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "dotenv": "^16.4.5",
    "jest": "^29.x",
    "jest-junit": "^16.x",
    "jest-mock-extended": "^3.x",
    "passport-custom": "^1.x",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.x",
    "typescript": "^5.x"
  }
}
