// =============================================================================
// Vault domain models (app-owned fragment)
// =============================================================================
// Composed with the @marinoscar/platform-db fragments into prisma/schema/ by
// `npm run db:compose`. Never edit prisma/schema/; edit this file.
//
// Back-relations to platform models are `extend model` blocks at the bottom.
// The media-folder link to storage_objects lives in media-folder-files.prisma.

// =============================================================================
// Media Folders
// =============================================================================

model MediaFolder {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user  User              @relation("UserMediaFolders", fields: [userId], references: [id], onDelete: Cascade)
  files MediaFolderFile[]

  @@index([userId])
  @@map("media_folders")
}

// =============================================================================
// Secrets (Vault)
// =============================================================================

model SecretType {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  icon             String?
  fields           Json     @db.JsonB
  allowAttachments Boolean  @default(false) @map("allow_attachments")
  isSystem         Boolean  @default(false) @map("is_system")
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  createdBy User?    @relation("UserSecretTypes", fields: [createdById], references: [id], onDelete: SetNull)
  secrets   Secret[]

  @@index([createdById])
  @@map("secret_types")
}

model Secret {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  typeId      String   @map("type_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  type        SecretType         @relation(fields: [typeId], references: [id])
  createdBy   User?              @relation("UserSecrets", fields: [createdById], references: [id], onDelete: SetNull)
  versions    SecretVersion[]
  attachments SecretAttachment[]

  @@unique([name, createdById])
  @@index([createdById])
  @@index([typeId])
  @@map("secrets")
}

model SecretVersion {
  id            String   @id @default(uuid()) @db.Uuid
  secretId      String   @map("secret_id") @db.Uuid
  version       Int
  encryptedData String   @map("encrypted_data")
  iv            String
  authTag       String   @map("auth_tag")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  isCurrent     Boolean  @default(false) @map("is_current")

  // Relations
  secret      Secret             @relation(fields: [secretId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("UserSecretVersions", fields: [createdById], references: [id], onDelete: SetNull)
  attachments SecretAttachment[]

  @@unique([secretId, version])
  @@index([secretId, isCurrent])
  @@map("secret_versions")
}

model SecretAttachment {
  id              String   @id @default(uuid()) @db.Uuid
  secretId        String   @map("secret_id") @db.Uuid
  secretVersionId String   @map("secret_version_id") @db.Uuid
  storageObjectId String   @map("storage_object_id") @db.Uuid
  role            String?
  label           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  secret        Secret        @relation(fields: [secretId], references: [id], onDelete: Cascade)
  secretVersion SecretVersion @relation(fields: [secretVersionId], references: [id], onDelete: Cascade)
  storageObject StorageObject @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)

  @@unique([secretVersionId, storageObjectId])
  @@unique([secretVersionId, role])
  @@index([secretId])
  @@index([storageObjectId])
  @@map("secret_attachments")
}

// Singleton row (id = 'default'), created lazily by the service via upsert.
model BackupSchedule {
  id                 String    @id @default("default")
  enabled            Boolean   @default(false)
  frequency          String    @default("daily") // hourly | daily | weekly | monthly
  intervalHours      Int?      @map("interval_hours")
  timeOfDay          String    @default("03:00") @map("time_of_day") // HH:mm
  dayOfWeek          Int?      @map("day_of_week") // 0-6, 0 = Sunday
  dayOfMonth         Int?      @map("day_of_month") // 1-28
  timezone           String    @default("UTC")
  keepCount          Int       @default(7) @map("keep_count")
  includeAttachments Boolean   @default(true) @map("include_attachments")
  includeVersions    Boolean   @default(false) @map("include_versions")
  includeSecrets     Boolean   @default(true) @map("include_secrets")
  includeMedia       Boolean   @default(false) @map("include_media")
  includeSystem      Boolean   @default(false) @map("include_system")
  passwordEncrypted  String?   @map("password_encrypted")
  passwordUpdatedAt  DateTime? @map("password_updated_at") @db.Timestamptz
  nextRunAt          DateTime? @map("next_run_at") @db.Timestamptz
  lastRunAt          DateTime? @map("last_run_at") @db.Timestamptz
  updatedById        String?   @map("updated_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  updatedBy User? @relation("BackupScheduleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("backup_schedules")
}

model BackupRun {
  id              String    @id @default(uuid()) @db.Uuid
  status          String // running | succeeded | failed
  trigger         String // schedule | manual
  triggeredById   String?   @map("triggered_by_id") @db.Uuid
  scope           String    @default("system") // system | user
  ownerId         String?   @map("owner_id") @db.Uuid // set when scope is user
  storageKey      String?   @map("storage_key")
  sizeBytes       BigInt?   @map("size_bytes")
  userCount       Int       @default(0) @map("user_count")
  secretCount     Int       @default(0) @map("secret_count")
  attachmentCount Int       @default(0) @map("attachment_count")
  mediaFileCount  Int       @default(0) @map("media_file_count")
  warningCount    Int       @default(0) @map("warning_count")
  contents        String[]  @default([])
  error           String?
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz
  heartbeatAt     DateTime? @map("heartbeat_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  triggeredBy User? @relation("BackupRunTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  owner       User? @relation("BackupRunOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
  @@index([triggeredById])
  @@index([scope, ownerId, startedAt])
  @@map("backup_runs")
}

// =============================================================================
// Back-relations on platform models (`extend model`)
// =============================================================================
// Relation names are unchanged from the former hand-edited schema.prisma.

extend model User {
  secretTypes            SecretType[]     @relation("UserSecretTypes")
  secrets                Secret[]         @relation("UserSecrets")
  secretVersions         SecretVersion[]  @relation("UserSecretVersions")
  mediaFolders           MediaFolder[]    @relation("UserMediaFolders")
  backupSchedulesUpdated BackupSchedule[] @relation("BackupScheduleUpdater")
  backupRunsTriggered    BackupRun[]      @relation("BackupRunTrigger")
  backupRunsOwned        BackupRun[]      @relation("BackupRunOwner")
}

extend model StorageObject {
  secretAttachments SecretAttachment[]
}
