{
  "name": "cli",
  "version": "2.0.0",
  "private": true,
  "description": "The vault command-line client, built on @marinoscar/platform-cli. Replaces tools/vaultcli and tools/app.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vault": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@app/shared": "*",
    "@inquirer/prompts": "7.10.1",
    "@marinoscar/platform-cli": "0.1.0-next.21",
    "chalk": "^5.3.0",
    "commander": "^14.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.x",
    "vitest": "^4.1.8"
  }
}
